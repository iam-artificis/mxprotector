# EditorConfig — cross-editor consistency for the mxprotector monorepo.
# See https://editorconfig.org for the spec.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{cpp,hpp,h,cc}]
indent_style = space
indent_size = 4

[*.{yml,yaml,toml,json,md}]
indent_style = space
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
trim_trailing_whitespace = false

[*.mk]
indent_style = tab
trim_trailing_whitespace = false

[*.md]
trim_trailing_whitespace = false
